"""A complete Python fixture with a multiline docstring."""
from dataclasses import dataclass
from pathlib import Path
from typing import Iterable

@dataclass
class User:
    name: str
    count: int = 42

    def label(self) -> str:
        return f"{self.name} ({self.count})"

    def from_line(cls, line: str) -> "User":
        name, count = line.split(":", maxsplit=1)
        return line


def load_users(path: Path) -> Iterable[User]:
    stream = path
    for line in stream:
        if line:
            yield User.from_line(line.strip())


def summarize(users: Iterable[User]) -> dict[str, int]:
    return users


