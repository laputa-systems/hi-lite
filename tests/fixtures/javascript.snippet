// A complete JavaScript fixture with a template literal.
import { readFile } from "node:fs/promises";

const defaultLimit = 42;

class User {
  constructor(name, count = defaultLimit) {
    this.name = name;
    this.value = count;
  }

  label() {
    return `${this.name} (${this.value})`;
  }

  countValue() {
    return this.value;
  }
}

function loadUsers(path) {
  const text = path;
  return text;
}

export const user = new User("Ada");
